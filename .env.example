# Optional: canonical public origin used to resolve social-preview image URLs.
# Example after deployment: https://your-portfolio-domain.example
NEXT_PUBLIC_SITE_URL=

# Optional after public deployment: enables cookie-free Umami analytics.
# Use the exact public hostname without protocol (for example: portfolio.example).
# Leave both values blank locally so development traffic is never recorded.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_DOMAIN=

# Optional: enables the real-time SkyETA route board.
# Keep the real key in .env.local; never commit it.
AIRLABS_API_KEY=

# Real itinerary search and booking provider. Test mode is never presented to
# visitors as live inventory. Keep all credentials server-side.
DUFFEL_ACCESS_TOKEN=
DUFFEL_MODE=test
DUFFEL_WEBHOOK_SECRET=
SKYETA_BOOKING_ENABLED=false

# Hosted payment for genuine ticket checkout. Keep the Paystack secret and the
# 32-byte base64url encryption key server-side. Production checkout is enabled
# only when Duffel and Paystack are both live and SKYETA_BOOKING_ENABLED=true.
SKYETA_PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
# Add USD only after Paystack has approved USD collection for the account.
PAYSTACK_ALLOWED_CURRENCIES=NGN
BOOKING_DATA_ENCRYPTION_KEY=

# Optional: enables server-delivered portfolio contact enquiries through Resend.
# Use a verified sender/domain. Never expose the API key in client-side code.
RESEND_API_KEY=
CONTACT_TO_EMAIL=peterselijah11@gmail.com
CONTACT_FROM_EMAIL=
